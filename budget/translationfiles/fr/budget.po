#: /app/src/modules/settings/SettingsModule.js:196
msgid ""
"No AI provider on this Nextcloud can read images yet, so this option will "
"not work until one is set up. Install an AI app with image support and "
"configure it in the Nextcloud admin settings."
msgstr ""
