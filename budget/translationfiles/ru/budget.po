msgid "Default Export Format"
msgstr "Формат экспорта по умолчанию"

#: /app/templates/index.php:4621
msgid "Preferred format for data exports"
msgstr "Предпочитаемый формат экспорта данных"

#: /app/templates/index.php:4624
