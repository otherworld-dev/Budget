msgstr ""
"Страница оплаты откроется в новой вкладке. Лицензионный ключ будет показан "
"один раз после оплаты и отправлен по электронной почте — вставьте его в поле "
"выше."

#: /app/templates/index.php:4836
msgid "Manage subscription"
msgstr "Управление подпиской"

#: /app/templates/index.php:4837
