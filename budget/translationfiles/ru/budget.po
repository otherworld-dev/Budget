msgstr "Автоматически применять правила импорта"

#: /app/templates/index.php:4603
msgid "Automatically categorize transactions when importing"
msgstr "Автоматически категоризировать транзакции при импорте"

#: /app/templates/index.php:4612
msgid "Skip Duplicate Transactions"
msgstr "Пропускать дубли транзакций"

#: /app/templates/index.php:4613
msgid "Automatically skip duplicate transactions during import"
msgstr "Автоматически пропускать дубли транзакций при импорте"

