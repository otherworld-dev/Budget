{
  "openapi": "3.0.3",
  "info": {
    "title": "Nextcloud Budget REST API",
    "version": "1.0",
    "description": "Public, versioned API for reading a Budget instance and recording transactions from outside the web UI — a phone capture app, a script, or automation tooling.\n\nAuthenticate with a Nextcloud app password (personal settings > Security), or a token obtained through Nextcloud's Login flow v2. Every request must also send `OCS-APIRequest: true`; without it Nextcloud answers 412.\n\nEvery response is wrapped in an OCS envelope — the payload is at `ocs.data`, and `ocs.meta.statuscode` mirrors the HTTP status. Schemas below describe the contents of `ocs.data`.\n\nThe internal endpoints the web UI itself calls (under /apps/budget/api/..., without /ocs/) are not part of this contract and change without notice.",
    "license": {
      "name": "AGPL-3.0",
      "url": "https://www.gnu.org/licenses/agpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "https://{host}/ocs/v2.php/apps/budget/api/v1",
      "variables": {
        "host": {
          "default": "cloud.example.com",
          "description": "Your Nextcloud host"
        }
      }
    }
  ],
  "security": [{ "basicAuth": [] }],
  "tags": [
    { "name": "discovery", "description": "Server and capability discovery" },
    { "name": "accounts", "description": "Read-only account reference data" },
    { "name": "categories", "description": "Read-only category reference data" },
    { "name": "transactions", "description": "Browse and record transactions" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["discovery"],
        "operationId": "getInfo",
        "summary": "Server info and capabilities",
        "description": "Call this first. Confirms the app is installed and the credentials work, and reports which optional features this instance has.",
        "responses": {
          "200": {
            "description": "Server info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InfoEnvelope" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" }
        }
      }
    },
    "/accounts": {
      "get": {
        "tags": ["accounts"],
        "operationId": "listAccounts",
        "summary": "List accounts",
        "description": "Every account the user owns plus every account shared with them. Balances are as of today; future-dated transactions are excluded.",
        "responses": {
          "200": {
            "description": "Accounts",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/Account" }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["categories"],
        "operationId": "listCategories",
        "summary": "List categories",
        "description": "Flat list; build the tree from parentId. Includes categories shared with the user.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["expense", "income"] },
            "description": "Restrict to one category type. Note categories are typed expense/income while transactions are typed debit/credit."
          }
        ],
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/Category" }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": ["transactions"],
        "operationId": "listTransactions",
        "summary": "List transactions",
        "description": "Most recent first, across every account the user can see.",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Restrict to one account."
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Restrict to one category."
          },
          {
            "name": "dateFrom",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Inclusive lower bound, YYYY-MM-DD."
          },
          {
            "name": "dateTo",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Inclusive upper bound, YYYY-MM-DD."
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Free-text match on description and vendor."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 },
            "description": "Values above the maximum are clamped, not rejected."
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0, "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of transactions",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": { "$ref": "#/components/schemas/TransactionPage" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" }
        }
      },
      "post": {
        "tags": ["transactions"],
        "operationId": "createTransaction",
        "summary": "Record a transaction",
        "description": "Rate limited to 60 per minute per user. The account balance is recalculated automatically. Writing into an account shared by another user records the transaction against that owner's ledger.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/NewTransaction" }
            },
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/NewTransaction" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created transaction",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": { "$ref": "#/components/schemas/Transaction" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "403": { "$ref": "#/components/responses/ReadOnly" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/transactions/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "tags": ["transactions"],
        "operationId": "getTransaction",
        "summary": "Get one transaction",
        "description": "From any account the user can see. The joined accountName / accountCurrency / categoryName fields are not included here.",
        "responses": {
          "200": {
            "description": "The transaction",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": { "$ref": "#/components/schemas/Transaction" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" }
        }
      }
    },
    "/transactions/{id}/receipts": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "tags": ["transactions"],
        "operationId": "listReceipts",
        "summary": "List a transaction's receipts",
        "description": "Owner-only: receipts live in the owner's Files, so a transaction in a shared account returns 404 here even though GET /transactions/{id} can read it.",
        "responses": {
          "200": {
            "description": "Receipts",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/Receipt" }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" }
        }
      },
      "post": {
        "tags": ["transactions"],
        "operationId": "uploadReceipt",
        "summary": "Attach a receipt photo",
        "description": "Owner-only. The file is stored in the user's own Files under Budget/Receipts/<year>/ and referenced from the transaction. Rate limited to 10 per minute per user.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG, PNG, WebP, HEIC, or PDF, up to 25 MB. The authoritative list is in GET / limits."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created receipt reference",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/OcsEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "ocs": {
                          "type": "object",
                          "properties": {
                            "data": { "$ref": "#/components/schemas/Receipt" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorised" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/MissingOcsHeader" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Nextcloud user ID plus an app password (personal settings > Security > Devices & sessions). Not the login password."
      }
    },
    "parameters": {
      "ocsHeader": {
        "name": "OCS-APIRequest",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "enum": ["true"] },
        "description": "Required on every request."
      }
    },
    "responses": {
      "Unauthorised": {
        "description": "Not authenticated, or the app password has been revoked.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/OcsFailure" }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid input; ocs.data.error says what.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "NotFound": {
        "description": "No such record, or one the user cannot see.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "ReadOnly": {
        "description": "The account is visible but not writable — a read-only share.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests; wait and retry.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/OcsFailure" }
          }
        }
      },
      "MissingOcsHeader": {
        "description": "The OCS-APIRequest: true header is missing."
      }
    },
    "schemas": {
      "OcsMeta": {
        "type": "object",
        "required": ["status", "statuscode"],
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "statuscode": { "type": "integer", "example": 200 },
          "message": { "type": "string", "example": "OK" }
        }
      },
      "OcsEnvelope": {
        "type": "object",
        "required": ["ocs"],
        "properties": {
          "ocs": {
            "type": "object",
            "required": ["meta", "data"],
            "properties": {
              "meta": { "$ref": "#/components/schemas/OcsMeta" }
            }
          }
        }
      },
      "OcsFailure": {
        "allOf": [
          { "$ref": "#/components/schemas/OcsEnvelope" },
          {
            "type": "object",
            "properties": {
              "ocs": {
                "type": "object",
                "properties": {
                  "data": { "type": "array", "items": {} }
                }
              }
            }
          }
        ]
      },
      "ErrorEnvelope": {
        "allOf": [
          { "$ref": "#/components/schemas/OcsEnvelope" },
          {
            "type": "object",
            "properties": {
              "ocs": {
                "type": "object",
                "properties": {
                  "data": { "$ref": "#/components/schemas/Error" }
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable, translated into the user's language.",
            "example": "Date must be in YYYY-MM-DD format"
          },
          "detail": {
            "type": "string",
            "description": "Present only for database faults, to make them diagnosable."
          }
        }
      },
      "InfoEnvelope": {
        "allOf": [
          { "$ref": "#/components/schemas/OcsEnvelope" },
          {
            "type": "object",
            "properties": {
              "ocs": {
                "type": "object",
                "properties": {
                  "data": { "$ref": "#/components/schemas/Info" }
                }
              }
            }
          }
        ]
      },
      "Info": {
        "type": "object",
        "required": ["apiVersion", "userId", "baseCurrency", "features", "limits"],
        "properties": {
          "apiVersion": {
            "type": "string",
            "example": "1.0",
            "description": "Contract version. Bumped only for a breaking change."
          },
          "appVersion": {
            "type": "string",
            "nullable": true,
            "example": "2.40.0",
            "description": "Advisory only — never gate on it."
          },
          "userId": { "type": "string", "example": "alice" },
          "baseCurrency": { "type": "string", "example": "GBP" },
          "features": {
            "type": "object",
            "description": "Optional capabilities of this instance. Values may flip from false to true as features land; clients must tolerate that.",
            "properties": {
              "accounts": { "type": "boolean" },
              "categories": { "type": "boolean" },
              "transactions": { "type": "boolean" },
              "createTransaction": { "type": "boolean" },
              "receiptUpload": { "type": "boolean" },
              "receiptOcr": {
                "type": "boolean",
                "description": "Server-side receipt extraction. Always false in v1."
              }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "maxReceiptBytes": { "type": "integer", "example": 26214400 },
              "receiptMimeTypes": {
                "type": "array",
                "items": { "type": "string" },
                "example": ["image/jpeg", "image/png", "image/webp", "image/heic", "application/pdf"]
              },
              "transactionsMaxLimit": { "type": "integer", "example": 200 }
            }
          }
        }
      },
      "Account": {
        "type": "object",
        "required": ["id", "name", "type", "currency", "balance", "shared"],
        "properties": {
          "id": { "type": "integer", "example": 36 },
          "name": { "type": "string", "example": "Current Account" },
          "type": {
            "type": "string",
            "example": "checking",
            "description": "checking, savings, credit_card, cash, investment, crypto, loan, other."
          },
          "currency": { "type": "string", "example": "GBP" },
          "balance": {
            "type": "number",
            "format": "double",
            "example": -1246.5,
            "description": "As of today; future-dated transactions are excluded."
          },
          "balanceInBaseCurrency": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Set only when the account is not already in the user's base currency."
          },
          "baseCurrency": { "type": "string", "nullable": true },
          "institution": { "type": "string", "nullable": true, "example": "NatWest" },
          "shared": {
            "type": "boolean",
            "description": "True for an account another user shared. It may be read-only — handle 403 on create."
          },
          "updatedAt": { "type": "string", "nullable": true, "example": "2026-08-01 03:20:02" }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "name", "type", "shared"],
        "properties": {
          "id": { "type": "integer", "example": 415 },
          "name": { "type": "string", "example": "Bank Fees" },
          "type": { "type": "string", "enum": ["expense", "income"] },
          "parentId": {
            "type": "integer",
            "nullable": true,
            "description": "Null for a top-level category."
          },
          "icon": { "type": "string", "nullable": true },
          "color": { "type": "string", "nullable": true, "example": "#ef4444" },
          "shared": { "type": "boolean" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "accountId", "date", "description", "amount", "type"],
        "properties": {
          "id": { "type": "integer", "example": 20070 },
          "accountId": { "type": "integer", "example": 36 },
          "categoryId": { "type": "integer", "nullable": true },
          "date": { "type": "string", "format": "date", "example": "2026-08-08" },
          "description": { "type": "string", "example": "Monthly plan" },
          "vendor": { "type": "string", "nullable": true, "example": "Practice Plan" },
          "amount": {
            "type": "number",
            "format": "double",
            "example": 15,
            "description": "Always positive; type carries the direction."
          },
          "type": {
            "type": "string",
            "enum": ["debit", "credit"],
            "description": "debit is money out, credit is money in."
          },
          "reference": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "example": "cleared",
            "description": "cleared, pending, or scheduled (a future-dated transaction)."
          },
          "reconciled": { "type": "boolean" },
          "isSplit": {
            "type": "boolean",
            "description": "True when the transaction is split across categories in the web UI. Splits are not exposed in v1."
          },
          "createdAt": { "type": "string", "nullable": true },
          "updatedAt": { "type": "string", "nullable": true },
          "accountName": {
            "type": "string",
            "description": "List responses only."
          },
          "accountCurrency": {
            "type": "string",
            "description": "List responses only."
          },
          "categoryName": {
            "type": "string",
            "description": "List responses only, and absent on uncategorised rows."
          }
        }
      },
      "TransactionPage": {
        "type": "object",
        "required": ["transactions", "total", "limit", "offset"],
        "properties": {
          "transactions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Transaction" }
          },
          "total": {
            "type": "integer",
            "description": "Full match count, not the page size."
          },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "NewTransaction": {
        "type": "object",
        "required": ["accountId", "date", "description", "amount", "type"],
        "properties": {
          "accountId": {
            "type": "integer",
            "description": "Must be an account the user can write to."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD. A future date is stored as scheduled."
          },
          "description": { "type": "string" },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Always positive."
          },
          "type": { "type": "string", "enum": ["debit", "credit"] },
          "categoryId": {
            "type": "integer",
            "nullable": true,
            "description": "Omit to file it as uncategorised."
          },
          "vendor": { "type": "string", "nullable": true },
          "reference": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "Receipt": {
        "type": "object",
        "required": ["id", "transactionId", "fileId", "missing"],
        "properties": {
          "id": { "type": "integer" },
          "transactionId": { "type": "integer" },
          "fileId": {
            "type": "integer",
            "description": "Nextcloud file id in the owner's Files — usable with WebDAV."
          },
          "fileName": { "type": "string", "nullable": true },
          "mimeType": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "nullable": true },
          "missing": {
            "type": "boolean",
            "description": "True when the underlying file has been deleted from Files; the reference survives."
          }
        }
      }
    }
  }
}
